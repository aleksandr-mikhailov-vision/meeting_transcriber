# Copy this file to .env and fill in the key(s) for the provider you use.
# .env is gitignored.

# OpenAI (default provider)
OPENAI_API_KEY=sk-your-openai-key-here

# Mistral (used with --provider mistral)
MISTRAL_API_KEY=your-mistral-key-here

# Optional defaults (CLI flags take precedence over these):
# TRANSCRIBE_PROVIDER=openai          # openai | mistral
# TRANSCRIBE_MODEL=gpt-4o-transcribe  # leave unset to use the provider's default
# TRANSCRIBE_LANGUAGE=en
